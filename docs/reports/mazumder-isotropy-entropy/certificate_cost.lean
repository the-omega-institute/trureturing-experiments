def rankRows : Nat → List Nat → Nat
  | 0, _ => 0
  | c + 1, rows =>
    match rows.find? (fun r => r.testBit c) with
    | none => rankRows c rows
    | some p => 1 + rankRows c ((rows.erase p).map (fun r => if r.testBit c then Nat.xor r p else r))

def rows (a : Nat) : List Nat :=
  (List.range 19).map fun j =>
    (List.range 19).foldl (fun v i => if a.testBit i then Nat.xor v ((slices[i]!)[j]!) else v) 0

def histogram (count : Nat) : List Nat :=
  (List.range count).foldl (fun h a =>
    let r := rankRows 19 (rows a)
    h.modify r (fun c => c + 1)) (List.replicate 20 0)




def histogramRange (offset count : Nat) : List Nat :=
  (List.range count).foldl (fun h b =>
    let r := rankRows 19 (rows (offset + b))
    h.modify r (fun c => c + 1)) (List.replicate 20 0)

